# DEV ENV
PROJECT_PATH=/workspace/spring-micro-47
MAVEN_REPO=/workspace/m2-repository/
SPRING_PROFILES_ACTIVE=default
#KEYCLOAK
KEYCLOAK_ADMIN_PASSWORD=admin
DOMAIN_SCHEME=http
DOMAIN_NAME=gateway
DOMAIN_PORT=8888
KC_HTTP_RELATIVE_PATH=sso
# GOOGLE
CLIENT_ID=<your-client-id>
CLIENT_SECRET=<your-client-secret>

EUREKA_PATH=/registry
EUREKA_SERVER_ADDRESS=http://serviceregistry:8761/registry/eureka
TRACING_URL=http://tracing:4317
CONFIG_SERVER_URL=http://configserver:9296

MYSQL_HOST=database
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
SQL_ROOT_PASSWORD=root

GITHUB_USER=<your-github-user>
GITHUB_TOKEN=<your-github-token>

ENVIRONMENT=production
API_BASE=
OAUTH_REDIRECT_URL=http://localhost:4200/auth/login

# MONGO
MONGO_HOST=mongo
MONGO_DATABASE=chat_service
MONGO_PORT=27017
MONGO_USERNAME=root
MONGO_PASSWORD=rootpassword
MONGO_AUTHENTICATION_DATABASE=admin

#REDIS
REDIS_URL=redis://redis:6379

##GATEWAY
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080

## AXON DATA
AXON_DATA=/workspace/axon
AXON_SERVER_URL=axonserver:8124

### PROD IMAGE TAG
IMAGE_TAG=0.7.1

### NOAUTH
NOAUTH_ENABLE=false
### MAILING
SPRING_MAIL_HOST=mailcatcher
SPRING_MAIL_PORT=1025
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false

LOGSTASH_HOST=logstash
LOGSTASH_URL=logstash